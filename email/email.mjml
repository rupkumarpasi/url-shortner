<mjml>
  <mj-head>
    <mj-title>Verify Your Email Address</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" padding="0px" />
      <mj-text font-size="16px" color="#333333" line-height="24px" />
      <mj-section background-color="#ffffff" padding="20px 0px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f8f9fa">
    <mj-section padding="40px 20px">
      <mj-column background-color="#ffffff" border-radius="8px" padding="30px">
        
        <!-- Heading -->
        <mj-text align="center" font-size="24px" font-weight="bold" color="#111111" padding-bottom="20px">
          Verify Your Email Address
        </mj-text>

        <!-- Intro Text -->
        <mj-text align="left" color="#444444" padding-bottom="20px">
          Thanks for signing up! Please verify your email address to complete your registration.
        </mj-text>

        <mj-text align="left" color="#444444" padding-bottom="15px">
          Your verification code:
        </mj-text>

        <!-- Verification Code Box -->
        <mj-section background-color="#f1f3f5" padding="15px" border-radius="6px">
          <mj-column>
            <mj-text align="center" font-size="28px" font-weight="bold" letter-spacing="4px" color="#111111">
             <%= token %>
            </mj-text>
          </mj-column>
        </mj-section>

        <!-- Alternative Text -->
        <mj-text align="center" color="#444444" padding="30px 0 20px 0">
          Alternatively, you can directly verify your account by clicking the button below:
        </mj-text>

        <!-- Button -->
        <mj-button 
        href="<%= link %>"
         background-color="#0066ff" color="#ffffff" font-size="16px" font-weight="bold" border-radius="6px" href="#" inner-padding="12px 24px" align="center">
          Verify My Email
        </mj-button>

        <!-- Footer Note -->
        <mj-text align="center" font-size="14px" color="#777777" padding-top="40px">
          If you didn't sign up for this account, you can safely ignore this email.
        </mj-text>

      </mj-column>
    </mj-section>
  </mj-body>
</mjml>