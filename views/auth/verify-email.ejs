<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email Address</title>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- External CSS -->
    <link rel="stylesheet" href="/verifyEmail.css">
</head>
<body>

    <div class="verification-card">
        <!-- Top Envelope Icon -->
        <div class="icon-container">
            <i class="fa-solid fa-envelope"></i>
        </div>

        <!-- Heading -->
        <h1 class="title">VERIFY YOUR EMAIL ADDRESS</h1>

        <!-- Divider Line -->
        <div class="divider"></div>

        <!-- Notification Message -->
        <p class="subtitle">
            A verification code has been sent to<br>
            <strong class="email-address"><%= user.email %></strong>
        </p>

        <!-- Instructions & Countdown -->
        <p class="instructions">
            Please check your inbox and enter the verification code below to verify your email address. The code will expire in <span id="timer">14:48</span>.
        </p>

        <!-- Verification Form -->
        <form class="verification-form">
            <!-- 6-digit OTP Inputs -->
             <input type="hidden" id="email" value="<%= user.email %>" />
            <div class="otp-inputs">
                <input type="text" maxlength="1" pattern="[0-9]" autofocus>
                <input type="text" maxlength="1" pattern="[0-9]">
                <input type="text" maxlength="1" pattern="[0-9]">
                <input type="text" maxlength="1" pattern="[0-9]">
                <input type="text" maxlength="1" pattern="[0-9]">
                <input type="text" maxlength="1" pattern="[0-9]">
            </div>

             <% if(errors.length>0){ %>
                <% errors.forEach((err)=>{  %>
                   <div class="error-message"><%= err %></div> 
              <%  }) %>
                   <%  } %>
            <!-- Submit Button -->
            <button type="submit" id="btn-verify">Verify</button>
        </form>

        <!-- Bottom Action Links -->
        <div class="action-links">
            <a href="/resend-verification-code" class="link">Resend code</a>
            <a href="/change-email" class="link">Change email</a>
        </div>
    </div>

    <script>
    document.querySelector(".verification-form").addEventListener("submit", (e) => {
    e.preventDefault();

    const email = document.getElementById("email").value;
    const inputs = document.querySelectorAll('.otp-inputs input');
    let otpCode = '';
    inputs.forEach(input => otpCode += input.value);

    if (otpCode.length !== 6) {
        alert('Please enter the complete 6-digit verification code.');
        return;
    }

    // Redirect the browser directly to the verification route
    window.location.href = `/verify-email-token?token=${encodeURIComponent(otpCode)}&email=${encodeURIComponent(email)}`;
});
    </script>
</body>
</html>