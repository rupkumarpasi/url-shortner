

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/change-password.css" />
</head>
<body>
     <div class="card">
    <div class="header">
        <h1>Forgot Your Password</h1>
         <h3>please enter the email address you would like your password reset information </h3>
    </div>
    <form id="passwordForm" action="/forgot-password" method="post">

         <div class="input-group">
            <label for="email">Enter your Registered Email</label>
        <input type="email" name="email"  placeholder="email here" required>
        </span>
      </div>

         <% if(errors.length>0){ %>
                <% errors.forEach((err)=>{  %>
                   <div class="error-message"><%= err %></div> 
              <%  }) %>
                   <%  } %>

      <!-- Submit Button -->
      <div class="button-group">
        <button type="submit" class="btn-submit">send Email</button>
      </div>

      </form>

<a href="/auth/login" style="color:#0b57d0;">Back to Login </a>
      </div>
     
</body>
</html>